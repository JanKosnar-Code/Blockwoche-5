<Window x:Class="AdressBuch.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdressBuch"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Login" Height="200" Width="400">
    <Grid>
        <TextBox Name="User" FontSize="20" HorizontalAlignment="Left" Margin="193,64,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBox Name="PWD" FontSize="20" HorizontalAlignment="Left" Margin="193,93,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBlock FontSize="20" HorizontalAlignment="Left" Margin="101,94,0,0" TextWrapping="Wrap" Text="Password:" VerticalAlignment="Top"/>
        <TextBlock FontSize="20" HorizontalAlignment="Left" Margin="101,65,0,0" TextWrapping="Wrap" Text="User:" VerticalAlignment="Top"/>
        <Button Content="Submit" HorizontalAlignment="Center" Margin="0,133,0,0" VerticalAlignment="Top" Click="SubmitClick"/>

    </Grid>
</Window>
